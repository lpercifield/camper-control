# ---- PlatformIO -------------------------------------------------------------
# Build output and downloaded packages: toolchains, frameworks and libraries,
# together well over a gigabyte. All of it is regenerated by `pio run`, and
# tools/patch_gfx.py re-applies our one library patch on every build, so nothing
# in here needs preserving. See docs/decisions/0007.
.pio/

# Older PlatformIO layouts, harmless to keep listed.
.pioenvs/
.piolibdeps/
.clang_complete
.gcc-flags.json

# ---- Toolchain built by tools/setup_toolchain.sh ----------------------------
# Only used by the Linux-only arduino-cli harness; see docs/decisions/0006.
.camper-toolchain/

# ---- Editors ----------------------------------------------------------------
# c_cpp_properties.json is regenerated per machine with absolute paths, so the
# directory is ignored; the recommended-extensions list is worth sharing.
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~

# ---- macOS ------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes

# ---- Scratch ----------------------------------------------------------------
*.bak
*.orig
*.rej
